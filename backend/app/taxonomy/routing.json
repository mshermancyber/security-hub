{
  "_meta": {
    "description": "Alert routing rules. Each rule subscribes to one or more WS event types and dispatches to a sink. Empty `target` falls back to env var for the sink (e.g. SLACK_WEBHOOK_URL).",
    "version": 1
  },
  "sinks": {
    "slack":  { "kind": "slack",  "webhook_env": "SLACK_WEBHOOK_URL" },
    "teams":  { "kind": "teams",  "webhook_env": "TEAMS_WEBHOOK_URL" },
    "email":  { "kind": "email",  "smtp_env":    "SECHUB_SMTP_URL",  "from_env": "SECHUB_FROM_EMAIL" },
    "cef":    { "kind": "cef",    "syslog_env":  "SECHUB_SYSLOG_URL" }
  },
  "rules": [
    {
      "id": "high-prio-news → slack",
      "enabled": true,
      "match": { "event_type": "news.item", "min_priority": 70 },
      "sink": "slack"
    },
    {
      "id": "any org alert → slack",
      "enabled": true,
      "match": { "event_type": "org.alert" },
      "sink": "slack"
    },
    {
      "id": "kev additions → slack + cef",
      "enabled": true,
      "match": { "event_type": "kev.batch", "min_count": 1 },
      "sinks": ["slack", "cef"]
    },
    {
      "id": "any event → cef syslog",
      "enabled": false,
      "match": { "event_type": "*" },
      "sink": "cef"
    },
    {
      "id": "acme-corp alerts → email CISO",
      "enabled": false,
      "match": { "event_type": "org.alert", "org": "acme-corp" },
      "sink": "email",
      "target": "ciso-acme@example.com"
    }
  ]
}
