# SecurityHub Terminal — docker-only deployment.
#
# Copy to `.env` and fill in keys for the integrations you want.
# (Anything you leave blank is fine — the corresponding feature degrades
# gracefully.)

# --- User-facing ports ---
# The backend is internal to the compose network on port 8080; only the
# frontend (nginx) is exposed.
SECHUB_HTTP_PORT=80
SECHUB_HTTPS_PORT=443

# --- Host UID/GID for bind-mount writes ---
# Backend container runs as this UID:GID so files written into ./data
# and ./backend/app/taxonomy land owned by the host operator. Set to
# the output of `id -u` / `id -g` of the user that will own the deploy.
# On macOS / Docker Desktop, both can be 0.
SECHUB_UID=1000
SECHUB_GID=1000

# --- Auth ---
# When SECHUB_AUTH_TOKEN is set, every /api/* request requires
# `Authorization: Bearer <token>`. When unset, set SECHUB_INSECURE=1 to
# acknowledge that you intentionally want an open API (LAN demos / dev).
# SECHUB_AUTH_TOKEN=
SECHUB_INSECURE=1

# --- Allowed CORS origins (comma-separated) ---
# Default: localhost on the configured ports. Set this when serving
# behind a real hostname.
# SECHUB_CORS_ORIGINS=https://intel.example.com

# --- Optional integration API keys ---
NVD_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=

# --- OpenAI-compatible LLM (pick ONE provider, set all three) ---
# OpenAI
# SECHUB_LLM_BASE_URL=https://api.openai.com/v1
# SECHUB_LLM_API_KEY=sk-...
# SECHUB_LLM_MODEL=gpt-4o-mini
#
# Anthropic Claude (OpenAI-compat endpoint)
# SECHUB_LLM_BASE_URL=https://api.anthropic.com/v1
# SECHUB_LLM_API_KEY=sk-ant-...
# SECHUB_LLM_MODEL=claude-sonnet-4-6
#
# Ollama on the docker host (no key required)
# SECHUB_LLM_BASE_URL=http://host.docker.internal:11434/v1
# SECHUB_LLM_API_KEY=
# SECHUB_LLM_MODEL=llama3.1

# --- Alert routing sinks ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SECHUB_SMTP_URL=
SECHUB_FROM_EMAIL=
SECHUB_SYSLOG_URL=

# --- AGPL §5d Appropriate Legal Notice ---
# Where users can fetch the source for THIS deployment. Default points
# upstream; override if you self-host modifications.
# SECHUB_SOURCE_URL=https://github.com/mshermancyber/security-hub
